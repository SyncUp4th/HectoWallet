# --- Chain access ---
# Sepolia RPC endpoint (Infura/Alchemy, free tier). Without it the app falls
# back to a public RPC, which is rate-limited and unreliable under load.
SEPOLIA_RPC_URL=

# --- Operator wallet (this app's own EOA) ---
# Holds the balances the app shows and signs its swaps. The wallet address is
# DERIVED from this key, so there is no separate address var to keep in sync.
# Distinct from the issuer EOA that minted the tokens and seeded the Uniswap
# pools — that key is not needed here and must never be stored in this repo.
# Generate one with:  node -e "console.log(require('viem/accounts').generatePrivateKey())"
OPERATOR_PRIVATE_KEY=
# Alternative to the raw key, if the wallet is mnemonic-derived:
OPERATOR_MNEMONIC=
# Read-only fallback for deploys that hold no key at all (balances still show,
# swaps are rejected). Ignored whenever a key above is set.
OPERATOR_ADDRESS=

# --- Per-company ERC20 token contracts on Sepolia ---
# Blank means that coin reports balance 0 with configured:false rather than
# crashing the endpoint. USDT is the 1-KRW reference asset and the routing hub
# for every swap; the UI displays it as "KRWC" (src/constants/coins.js).
TOKEN_ADDRESS_USDT=
TOKEN_ADDRESS_HIPC=
TOKEN_ADDRESS_HFPC=
TOKEN_ADDRESS_HHPC=
TOKEN_ADDRESS_OLIVEPC=

# --- Etherscan (transaction history in the 거래내역 tab) ---
# Free self-serve key at https://etherscan.io/apis — the V2 API covers Sepolia
# via chainid=11155111 with the same key used for mainnet.
ETHERSCAN_API_KEY=

# Swap execution needs no config: the Uniswap V3 router/quoter addresses and
# the 0.01% pool fee tier are constants in src/chain/uniswap.js.

PORT=8080
