# --- Chain access (required for real on-chain asset reads) ---
# Free RPC from https://infura.io or https://alchemy.com — create an app for
# "Ethereum Sepolia" and paste its HTTPS endpoint here. Leave unset and the
# app falls back to a public Sepolia RPC (works, but rate-limited/unreliable).
SEPOLIA_RPC_URL=

# Public address of the HectoWallet treasury wallet whose ERC20 balances the
# Assets tab reads. This is a PUBLIC address, not a secret.
TREASURY_ADDRESS=

# --- Per-company ERC20 token contract addresses on Sepolia ---
# Leave any of these blank and that coin reports balance 0 with
# configured:false instead of crashing the endpoint.
# USDT is a real deployed USDT contract, used here as the 1-KRW reference
# asset since no separate KRW stablecoin was deployed for the demo — the
# frontend displays it as "KRW", never as "USDT" (src/constants/coins.js).
TOKEN_ADDRESS_USDT=
TOKEN_ADDRESS_OLIVEPC=
TOKEN_ADDRESS_HHPC=
TOKEN_ADDRESS_HIPC=
TOKEN_ADDRESS_HFPC=

# --- Etherscan (for the transaction explorer) ---
# Free signup + API key: https://etherscan.io/apis (self-serve, no approval
# process). Etherscan's V2 API covers Sepolia via chainid=11155111 with the
# same key used for mainnet.
ETHERSCAN_API_KEY=

# --- Swap smart contract (custodial — treasury signs server-side) ---
# Address of the deployed swap contract on Sepolia. If the contract is
# Etherscan-verified, the backend auto-fetches its ABI on first use.
# If not verified, paste the ABI manually into src/chain/swapAbi.json.
# The backend expects the contract to expose:
#   function swap(address fromToken, address toToken, uint256 amount) external
SWAP_CONTRACT_ADDRESS=

# --- Treasury signing key (NEVER commit — repo is public) ---
# The backend loads exactly ONE of these at startup to sign swap transactions.
# Prefer TREASURY_PRIVATE_KEY (0x-prefixed hex). Use TREASURY_MNEMONIC only
# if the key was derived from a mnemonic and you don't have the raw key.
TREASURY_PRIVATE_KEY=
TREASURY_MNEMONIC=

PORT=8080
