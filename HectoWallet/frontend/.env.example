# Leave empty to run against the built-in mock data (src/api/mock.js) with no backend.
# Point this at your backend once it implements the REST contract in README.md.
# Works identically whether the backend is Spring Boot or Node.js.
VITE_API_BASE_URL=

# Enables the WalletConnect connector (mobile QR-connect / Binance Wallet
# app / etc). Free signup: https://cloud.reown.com. Without it, MetaMask and
# other EIP-6963 browser-extension wallets still work fine on their own.
VITE_WALLETCONNECT_PROJECT_ID=
